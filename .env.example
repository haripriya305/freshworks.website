# ---------- REQUIRED for production ----------
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---------- DATABASE (optional) ----------
# Leave all DB_* empty  -> app runs on a built-in in-memory store (demo mode, data resets on restart/cold start).
# Fill them in          -> app uses MySQL, auto-creates tables and demo data on first request.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true          # true for cloud MySQL (Aiven / TiDB Cloud / Railway / PlanetScale); false for local MySQL

# ---------- LOCAL ONLY ----------
PORT=5000

# ---------- EMAIL (optional) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FreshWorks <no-reply@freshworks-demo.com>"
ADMIN_EMAIL=admin@freshworks-demo.com
